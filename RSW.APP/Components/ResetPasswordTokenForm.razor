@using RSW.Shared.Dto
@using Radzen
@inject NotificationService notificationService
@inject RSW.APP.Services.AuthService AuthService

<RadzenTemplateForm Data="@resetPasswordTokenModel" Submit="@OnSubmit" TItem="ResetPasswordTokenRequest">
    <RadzenFieldset>
        <!-- Email -->
        <RadzenLabel Text="Email" />
        <RadzenTextBox @bind-Value="resetPasswordTokenModel.Email" Name="Email" Style="width: 100%;" />
        <RadzenDataAnnotationValidator Component="Email" Popup="true" Style="position: absolute;" />

        <!-- Foutmelding -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <RadzenAlert Severity="AlertSeverity.Error" Style="margin-top: 20px;">
                @ErrorMessage
            </RadzenAlert>
        }

        <!-- Submit knop -->
        <RadzenButton Text="Reset token aanvragen" ButtonType="ButtonType.Submit" Style="margin-top: 20px; width: 100%;" />
    </RadzenFieldset>
</RadzenTemplateForm>

@code {
    private ResetPasswordTokenRequest resetPasswordTokenModel = new();

    [Parameter] public EventCallback OnResetTokenSuccess { get; set; }
    [Parameter] public EventCallback<string> OnResetTokenFailed { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private async Task OnSubmit()
    {
        try
        {
            await AuthService.GeneratePasswordResetTokenAsync(resetPasswordTokenModel);

            await OnResetTokenSuccess.InvokeAsync();
            notificationService.Notify(new NotificationMessage
            {
                Summary = "Succes",
                Detail = "Reset token is verzonden naar je e-mail.",
                Severity = NotificationSeverity.Success
            });
        }
        catch (Exception ex)
        {
            ErrorMessage = "Reset token aanvragen mislukt.";
            await OnResetTokenFailed.InvokeAsync(ex.Message);

            notificationService.Notify(new NotificationMessage
            {
                Summary = "Fout",
                Detail = ex.Message,
                Severity = NotificationSeverity.Error
            });
        }
    }
}
