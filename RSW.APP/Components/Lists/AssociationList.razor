@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenDataGrid @ref="dataGrid" Data="@associations" TItem="AssociationDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
    <Columns>
        <RadzenDataGridColumn TItem="AssociationDto" Property="Name" Title="Name" >
            <EditTemplate Context="association">
                <RadzenFormField Text="Naam" Style="width:100%">
                    <RadzenTextBox @bind-Value="@association.Name" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AssociationDto" Property="Abbreviation" Title="Abbreviation" >
            <EditTemplate Context="association">
                <RadzenFormField Text="Afkorting" Style="width:100%">
                    <RadzenTextBox @bind-Value="@association.Abbreviation" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
            <HeaderTemplate>
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
            </HeaderTemplate>
            <Template Context="association">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(association))" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(association))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(association))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="association">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(association))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(association))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(association))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<AssociationDto> associations { get; set; } = new List<AssociationDto>();
    public EventCallback<AssociationDto> OnAssociationDtoSelected { get; set; }
    private RadzenDataGrid<AssociationDto> dataGrid;

    [Inject]
    private IAssociationService associationService { get; set; } = default!;

    private async Task OnRowSelect(AssociationDto association)
    {
        if (OnAssociationDtoSelected.HasDelegate)
        {
            await OnAssociationDtoSelected.InvokeAsync(association);
        }
    }
    void Insert()
    {
        var NewAssociation = new AssociationDto();
        dataGrid.InsertRow(NewAssociation);
    }
    void InsertAfterRow(AssociationDto association)
    {
        var NewAssociation = new AssociationDto();
        dataGrid.InsertAfterRow(NewAssociation, association);
    }
    void EditRow(AssociationDto association)
    {
        dataGrid.EditRow(association);
    }
    async Task DeleteRow(AssociationDto association)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{association.Name}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (association.Id != Guid.Empty)
            {
                await associationService.DeleteAsync(association.Id);
            }
            associations.Remove(association);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(AssociationDto association)
    {
        if (association.Id == Guid.Empty)
        {
            await associationService.CreateAsync(new AssociationCreateDto
            {
                Name = association.Name,
                Abbreviation = association.Abbreviation
            });
        }
        else
        {
            await associationService.UpdateAsync(association.Id, association);
        }
        await dataGrid.UpdateRow(association);
    }
    async Task SaveAll()
    {
        foreach (AssociationDto association in associations)
        {
            if (association.Id == Guid.Empty)
            {
                await associationService.CreateAsync(new AssociationCreateDto
                    {
                        Name = association.Name,
                        Abbreviation = association.Abbreviation
                    });
            }
            else
            {
                await associationService.UpdateAsync(association.Id, association);
            }
            await dataGrid.UpdateRow(association);
        }
    }
    async Task CancelEdit(AssociationDto association)
    {
        if (association.Id == Guid.Empty)
        {
            associations.Remove(association);
            await dataGrid.Reload();
        }
        else
        {
            var OldAssociation = await associationService.GetByIdAsync(association.Id);
            if (OldAssociation != null)
            {
                association.Name = OldAssociation.Name;
                association.Abbreviation = OldAssociation.Abbreviation;
                
                await dataGrid.UpdateRow(association);
                dataGrid.CancelEditRow(association);
            }
        }
    }
}
