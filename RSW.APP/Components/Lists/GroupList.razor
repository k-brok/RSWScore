@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IAssociationService associationService

<RadzenDataGrid @ref="dataGrid" Data="@groups" TItem="GroupDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
    <Columns>
        <RadzenDataGridColumn TItem="GroupDto" Property="Name" Title="Name" >
            <EditTemplate Context="group">
                <RadzenFormField Text="Naam" Style="width:100%">
                    <RadzenTextBox @bind-Value="@group.Name" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GroupDto" Property="AssociationId" Title="Vereniging">
            <Template Context="criteria">
                @associationDtos.FirstOrDefault(C => C.Id == criteria.AssociationId).Name
            </Template>
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Vereniging" Style="width:100%">
                    <RadzenDropDown Data="@associationDtos" @bind-Value=criteria.AssociationId ValueProperty=@nameof(AssociationDto.Id) TextProperty=@nameof(AssociationDto.Name) />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
            <HeaderTemplate>
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
            </HeaderTemplate>
            <Template Context="group">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(group))" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(group))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(group))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="group">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(group))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(group))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(group))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<GroupDto> groups { get; set; } = new List<GroupDto>();
    public EventCallback<GroupDto> OnGroupDtoSelected { get; set; }
    private RadzenDataGrid<GroupDto> dataGrid;
    private IEnumerable<AssociationDto> associationDtos { get; set; } = new List<AssociationDto>();

    [Inject]
    private IGroupService groupService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        associationDtos = await associationService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(GroupDto group)
    {
        if (OnGroupDtoSelected.HasDelegate)
        {
            await OnGroupDtoSelected.InvokeAsync(group);
        }
    }
    void Insert()
    {
        var NewGroup = new GroupDto();
        dataGrid.InsertRow(NewGroup);
    }
    void InsertAfterRow(GroupDto group)
    {
        var NewGroup = new GroupDto();
        dataGrid.InsertAfterRow(NewGroup, group);
    }
    void EditRow(GroupDto group)
    {
        dataGrid.EditRow(group);
    }
    async Task DeleteRow(GroupDto group)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{group.Name}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (group.Id != Guid.Empty)
            {
                await groupService.DeleteAsync(group.Id);
            }
            groups.Remove(group);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(GroupDto group)
    {
        if (group.Id == Guid.Empty)
        {
            await groupService.CreateAsync(new GroupCreateDto
            {
                Name = group.Name,
                AssociationId = group.AssociationId
            });
        }
        else
        {
            await groupService.UpdateAsync(group.Id, group);
        }
        await dataGrid.UpdateRow(group);
    }
    async Task SaveAll()
    {
        foreach (GroupDto group in groups)
        {
            if (group.Id == Guid.Empty)
            {
                await groupService.CreateAsync(new GroupCreateDto
                    {
                        Name = group.Name,
                        AssociationId = group.AssociationId
                    });
            }
            else
            {
                await groupService.UpdateAsync(group.Id, group);
            }
            await dataGrid.UpdateRow(group);
        }
    }
    async Task CancelEdit(GroupDto group)
    {
        if (group.Id == Guid.Empty)
        {
            groups.Remove(group);
            await dataGrid.Reload();
        }
        else
        {
            var OldGroup = await groupService.GetByIdAsync(group.Id);
            if (OldGroup != null)
            {
                group.Name = OldGroup.Name;
                group.AssociationId = OldGroup.AssociationId;
                
                await dataGrid.UpdateRow(group);
                dataGrid.CancelEditRow(group);
            }
        }
    }
}
