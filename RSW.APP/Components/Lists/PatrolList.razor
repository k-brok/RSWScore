@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IGroupService groupService
@inject ISubGroupService subGroupService
@if(groupDtos == null || subGroupDtos == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@patrols" TItem="PatrolDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="PatrolDto" Property="Name" Title="Name" >
                <EditTemplate Context="patrol">
                    <RadzenFormField Text="Naam" Style="width:100%">
                        <RadzenTextBox @bind-Value="@patrol.Name" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="GroupId" Title="Groep">
                <Template Context="patrol">
                    @groupDtos.FirstOrDefault(C => C.Id == patrol.GroupId).Name
                </Template>
                <EditTemplate Context="patrol">
                    <RadzenFormField Text="Groep" Style="width:100%">
                        <RadzenDropDown Data="@groupDtos" @bind-Value=patrol.GroupId ValueProperty=@nameof(GroupDto.Id)>
                            <Template>
                                @((context as GroupDto).Name)
                            </Template>
                        </RadzenDropDown>
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="IsYoungest" Title="Jongste" >
                <EditTemplate Context="patrol">
                    <RadzenSwitch @bind-Value="@patrol.IsYoungest" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="Number" Title="Nummer" >
                <EditTemplate Context="patrol">
                    <RadzenFormField Text="Nummer" Style="width:100%">
                        <RadzenNumeric @bind-Value="@patrol.Number" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="Position" Title="Positie" >
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="SubgroupId" Title="Sub-kamp">
                <Template Context="patrol">
                    @subGroupDtos.FirstOrDefault(C => C.Id == patrol.SubGroupId).Color
                </Template>
                <EditTemplate Context="patrol">
                    <RadzenFormField Text="sub-kamp" Style="width:100%">
                        <RadzenDropDown Data="@subGroupDtos" @bind-Value=patrol.SubGroupId ValueProperty=@nameof(SubGroupDto.Id) TextProperty=@nameof(SubGroupDto.Color) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PatrolDto" Property="TotalScore" Title="Totale Scores" >
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="patrol">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(patrol))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(patrol))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(patrol))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="patrol">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(patrol))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(patrol))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(patrol))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Parameter]
    public List<PatrolDto> patrols { get; set; } = new List<PatrolDto>();
    public List<PatrolDto> NewPatrols { get; set; } = new List<PatrolDto>();
    public EventCallback<PatrolDto> OnPatrolDtoSelected { get; set; }
    private RadzenDataGrid<PatrolDto> dataGrid;
    private IEnumerable<GroupDto>? groupDtos { get; set; } = null;
    private IEnumerable<SubGroupDto>? subGroupDtos { get; set; } = null;

    [Inject]
    private IPatrolService patrolService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        groupDtos = await groupService.GetAllAsync();
        subGroupDtos = await subGroupService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(PatrolDto patrol)
    {
        if (OnPatrolDtoSelected.HasDelegate)
        {
            await OnPatrolDtoSelected.InvokeAsync(patrol);
        }
    }
    void Insert()
    {
        var NewPatrol = new PatrolDto();
        dataGrid.InsertRow(NewPatrol);
    }
    void InsertAfterRow(PatrolDto patrol)
    {
        var NewPatrol = new PatrolDto();
        dataGrid.InsertAfterRow(NewPatrol, patrol);
    }
    void EditRow(PatrolDto patrol)
    {
        dataGrid.EditRow(patrol);
    }
    async Task DeleteRow(PatrolDto patrol)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{patrol.Name}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (patrol.Id != Guid.Empty)
            {
                await patrolService.DeleteAsync(patrol.Id);
            }
            patrols.Remove(patrol);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(PatrolDto patrol)
    {
        if (patrol.Id == Guid.Empty)
        {
            await patrolService.CreateAsync(new PatrolCreateDto
            {
                Name = patrol.Name,
                GroupId = patrol.GroupId,
                IsYoungest = patrol.IsYoungest
            });
        }
        else
        {
            await patrolService.UpdateAsync(patrol.Id, patrol);
        }
        await dataGrid.UpdateRow(patrol);
    }
    async Task SaveAll()
    {
        foreach (PatrolDto patrol in patrols)
        {
            if (patrol.Id == Guid.Empty)
            {
                await patrolService.CreateAsync(new PatrolCreateDto
                    {
                        Name = patrol.Name,
                        GroupId = patrol.GroupId,
                        IsYoungest = patrol.IsYoungest
                    });
            }
            else
            {
                await patrolService.UpdateAsync(patrol.Id, patrol);
            }
            await dataGrid.UpdateRow(patrol);
        }
    }
    async Task CancelEdit(PatrolDto patrol)
    {
        if (patrol.Id == Guid.Empty)
        {
            patrols.Remove(patrol);
            await dataGrid.Reload();
        }
        else
        {
            var OldPatrol = await patrolService.GetByIdAsync(patrol.Id);
            if (OldPatrol != null)
            {
                patrol.Name = OldPatrol.Name;
                patrol.GroupId = OldPatrol.GroupId;
                patrol.IsYoungest = OldPatrol.IsYoungest;
                patrol.Number = OldPatrol.Number;
                patrol.SubGroupId = OldPatrol.SubGroupId;
                
                await dataGrid.UpdateRow(patrol);
                dataGrid.CancelEditRow(patrol);
            }
        }
    }
}
