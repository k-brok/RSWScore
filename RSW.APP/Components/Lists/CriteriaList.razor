@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ICriteriaService criteriaService
@inject ISubCategoryService subCategoryService

<RadzenDataGrid @ref="dataGrid" Data="@criterias" TItem="CriteriaDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
    <Columns>
        <RadzenDataGridColumn TItem="CriteriaDto" Property="Name" Title="Name" >
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Naam" Style="width:100%">
                    <RadzenTextBox @bind-Value="@criteria.Name" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CriteriaDto" Property="Description" Title="Omschrijving">
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Omschrijving" Style="width:100%">
                    <RadzenTextArea @bind-Value="@criteria.Description" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CriteriaDto" Property="MaxScore" Title="Maximale score">
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Maximale score" Style="width:100%">
                    <RadzenNumeric @bind-Value="@criteria.MaxScore" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CriteriaDto" Property="MaxScore" Title="Maximale score">
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Maximale score" Style="width:100%">
                    <RadzenNumeric @bind-Value="@criteria.MaxScore" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CriteriaDto" Property="MaxScore" Title="Sub Categorie">
            <EditTemplate Context="criteria">
                <RadzenFormField Text="Sub categorie" Style="width:100%">
                    <RadzenDropDown Data="@subCategoryDtos" @bind-Value=criteria.SubCategoryId ValueProperty=@nameof(SubCategoryDto.Id) TextProperty=@nameof(SubCategoryDto.Name) />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
            <HeaderTemplate>
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
            </HeaderTemplate>
            <Template Context="criteria">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(criteria))" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(criteria))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(criteria))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="criteria">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(criteria))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(criteria))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(criteria))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<CriteriaDto> criterias { get; set; } = new List<CriteriaDto>();
    public EventCallback<CriteriaDto> OnCriteriaDtoSelected { get; set; }

    private IEnumerable<SubCategoryDto> subCategoryDtos { get; set; } = new List<SubCategoryDto>();

    private RadzenDataGrid<CriteriaDto> dataGrid;

    protected override async Task OnInitializedAsync()
    {
        subCategoryDtos = await subCategoryService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    private async Task OnRowSelect(CriteriaDto criteria)
    {
        if (OnCriteriaDtoSelected.HasDelegate)
        {
            await OnCriteriaDtoSelected.InvokeAsync(criteria);
        }
    }
    void Insert()
    {
        var NewCriteria = new CriteriaDto();
        dataGrid.InsertRow(NewCriteria);
    }
    void InsertAfterRow(CriteriaDto criteria)
    {
        var NewCriteria = new CriteriaDto();
        dataGrid.InsertAfterRow(NewCriteria, criteria);
    }
    void EditRow(CriteriaDto criteria)
    {
        dataGrid.EditRow(criteria);
    }
    async Task DeleteRow(CriteriaDto criteria)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{criteria.Name}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (criteria.Id != Guid.Empty)
            {
                await criteriaService.DeleteAsync(criteria.Id);
            }
            criterias.Remove(criteria);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(CriteriaDto criteria)
    {
        if (criteria.Id == Guid.Empty)
        {
            await criteriaService.CreateAsync(new CriteriaCreateDto
            {
                Name = criteria.Name,
                Description = criteria.Description,
                MaxScore = criteria.MaxScore,
                SubCategoryId = criteria.SubCategoryId
            });
        }
        else
        {
            await criteriaService.UpdateAsync(criteria.Id, criteria);
        }
        await dataGrid.UpdateRow(criteria);
    }
    async Task SaveAll()
    {
        foreach (CriteriaDto criteria in criterias)
        {
            if (criteria.Id == Guid.Empty)
            {
                await criteriaService.CreateAsync(new CriteriaCreateDto
                    {
                        Name = criteria.Name,
                        Description = criteria.Description,
                        MaxScore = criteria.MaxScore,
                        SubCategoryId = criteria.SubCategoryId
                    });
            }
            else
            {
                await criteriaService.UpdateAsync(criteria.Id, criteria);
            }
            await dataGrid.UpdateRow(criteria);
        }
    }
    async Task CancelEdit(CriteriaDto criteria)
    {
        if (criteria.Id == Guid.Empty)
        {
            criterias.Remove(criteria);
            await dataGrid.Reload();
        }
        else
        {
            var OldCriteria = await criteriaService.GetByIdAsync(criteria.Id);
            if (OldCriteria != null)
            {
                criteria.Name = OldCriteria.Name;
                criteria.Description = OldCriteria.Description;
                criteria.MaxScore = OldCriteria.MaxScore;
                criteria.SubCategoryId = OldCriteria.SubCategoryId;

                await dataGrid.UpdateRow(criteria);
                dataGrid.CancelEditRow(criteria);
            }
        }
    }
}
