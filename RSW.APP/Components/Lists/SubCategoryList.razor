@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ISubCategoryService subcategoryService
@inject ICategoryService categoryService
@if(categorys == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@subcategories" TItem="SubCategory" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="SubCategory" Property="Name" Title="Name" >
                <EditTemplate Context="subcategory">
                    <RadzenFormField Text="Naam" Style="width:100%">
                        <RadzenTextBox @bind-Value="@subcategory.Name" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SubCategory" Property="CategoryId" Title="Categorie">
                <Template Context="subcategory">
                    @categorys.FirstOrDefault(C => C.Id == subcategory.CategoryId).Name
                </Template>
                <EditTemplate Context="subcategory">
                    <RadzenFormField Text="Sub categorie" Style="width:100%">
                        <RadzenDropDown Data="@categorys" @bind-Value=subcategory.CategoryId ValueProperty=@nameof(Category.Id) TextProperty=@nameof(Category.Name) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="subcategory">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(subcategory))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(subcategory))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(subcategory))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="subcategory">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(subcategory))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(subcategory))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(subcategory))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
@code {
    [Parameter]
    public List<SubCategory> subcategories { get; set; } = new List<SubCategory>();
    public EventCallback<SubCategory> OnSubCategorySelected { get; set; }
    private RadzenDataGrid<SubCategory> dataGrid;
    private IEnumerable<Category>? categorys {get; set;} = null;
    protected override async Task OnInitializedAsync()
    {
        categorys = await categoryService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(SubCategory subcategory)
    {
        if (OnSubCategorySelected.HasDelegate)
        {
            await OnSubCategorySelected.InvokeAsync(subcategory);
        }
    }
    void Insert()
    {
        var NewSubCategory = new SubCategory();
        dataGrid.InsertRow(NewSubCategory);
    }
    void InsertAfterRow(SubCategory subcategory)
    {
        var NewSubCategory = new SubCategory();
        dataGrid.InsertAfterRow(NewSubCategory, subcategory);
    }
    void EditRow(SubCategory subcategory)
    {
        dataGrid.EditRow(subcategory);
    }
    async Task DeleteRow(SubCategory subcategory)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{subcategory.Name}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (subcategory.Id != Guid.Empty)
            {
                await subcategoryService.DeleteAsync(subcategory.Id);
            }
            subcategories.Remove(subcategory);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(SubCategory subcategory)
    {
        if (subcategory.Id == Guid.Empty)
        {
            await subcategoryService.CreateAsync(new SubCategoryCreate
            {
                Name = subcategory.Name,
                CategoryId = subcategory.CategoryId
            });
        }
        else
        {
            await subcategoryService.UpdateAsync(subcategory.Id, subcategory);
        }
        await dataGrid.UpdateRow(subcategory);
    }
    async Task SaveAll()
    {
        foreach (SubCategory subcategory in subcategories)
        {
            if (subcategory.Id == Guid.Empty)
            {
                await subcategoryService.CreateAsync(new SubCategoryCreate
                    {
                        Name = subcategory.Name,
                        CategoryId = subcategory.CategoryId
                    });
            }
            else
            {
                await subcategoryService.UpdateAsync(subcategory.Id, subcategory);
            }
            await dataGrid.UpdateRow(subcategory);
        }
    }
    async Task CancelEdit(SubCategory subcategory)
    {
        if (subcategory.Id == Guid.Empty)
        {
            subcategories.Remove(subcategory);
            await dataGrid.Reload();
        }
        else
        {
            var OldSubCategory = await subcategoryService.GetByIdAsync(subcategory.Id);
            if (OldSubCategory != null)
            {
                subcategory.Name = OldSubCategory.Name;
                subcategory.CategoryId = OldSubCategory.CategoryId;
                
                await dataGrid.UpdateRow(subcategory);
                dataGrid.CancelEditRow(subcategory);
            }
        }
    }
}
