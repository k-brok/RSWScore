@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenDataGrid @ref="dataGrid" Data="@editions" TItem="EditionDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
    <Columns>
        <RadzenDataGridColumn TItem="EditionDto" Property="RSWStartDate" Title="RSW datum" >
            <EditTemplate Context="edition">
                <RadzenFormField Text="RSW datum" Style="width:100%">
                    <RadzenDatePicker @bind-Value="@edition.RSWStartDate" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EditionDto" Property="LSWStartDate" Title="LSW datum" >
            <EditTemplate Context="edition">
                <RadzenFormField Text="LSW Datum" Style="width:100%">
                    <RadzenDatePicker @bind-Value="@edition.LSWStartDate" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EditionDto" Property="Theme" Title="Thema" >
            <EditTemplate Context="edition">
                <RadzenFormField Text="Thema" Style="width:100%">
                    <RadzenTextBox @bind-Value="@edition.Theme" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EditionDto" Property="IsActive" Title="Actief" >
            <EditTemplate Context="edition">
                <RadzenButton Text="Activeren" Click=@(()=> ActivateEdition(edition)) Disabled=@edition.IsActive />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EditionDto" Title="Details" >
            <Template Context="edition">
                <RadzenButton Text="Details" Click=@(()=> OpenDialog(edition))/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
            <HeaderTemplate>
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
            </HeaderTemplate>
            <Template Context="edition">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(edition))" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(edition))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(edition))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="edition">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(edition))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(edition))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(edition))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<EditionDto> editions { get; set; } = new List<EditionDto>();
    public List<EditionDto> NewEditions { get; set; } = new List<EditionDto>();
    public EventCallback<EditionDto> OnEditionDtoSelected { get; set; }
    private RadzenDataGrid<EditionDto> dataGrid;

    [Inject]
    private IEditionService editionService { get; set; } = default!;

    private async Task OnRowSelect(EditionDto edition)
    {
        if (OnEditionDtoSelected.HasDelegate)
        {
            await OnEditionDtoSelected.InvokeAsync(edition);
        }
    }
    void Insert()
    {
        var NewEdition = new EditionDto();
        dataGrid.InsertRow(NewEdition);
    }
    void InsertAfterRow(EditionDto edition)
    {
        var NewEdition = new EditionDto();
        dataGrid.InsertAfterRow(NewEdition, edition);
    }
    void EditRow(EditionDto edition)
    {
        dataGrid.EditRow(edition);
    }
    async Task DeleteRow(EditionDto edition)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{edition.Theme}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (edition.Id != Guid.Empty)
            {
                await editionService.DeleteAsync(edition.Id);
            }
            editions.Remove(edition);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(EditionDto edition)
    {
        if (edition.Id == Guid.Empty)
        {
            var NewEdition = await editionService.CreateAsync(new EditionCreateDto
            {
                RSWStartDate = edition.RSWStartDate,
                LSWStartDate = edition.LSWStartDate,
                Theme = edition.Theme
            });
            if(await editionService.GetActiveAsync() == null)
                await editionService.ActivateAsync(NewEdition.Id);
        }
        else
        {
            await editionService.UpdateAsync(edition.Id, edition);
        }
        await dataGrid.UpdateRow(edition);
    }
    async Task SaveAll()
    {
        foreach (EditionDto edition in editions)
        {
            if (edition.Id == Guid.Empty)
            {
                var NewEdition = await editionService.CreateAsync(new EditionCreateDto
                    {
                        RSWStartDate = edition.RSWStartDate,
                        LSWStartDate = edition.LSWStartDate,
                        Theme = edition.Theme
                    });
                if(await editionService.GetActiveAsync() == null)
                    await editionService.ActivateAsync(NewEdition.Id);
            }
            else
            {
                await editionService.UpdateAsync(edition.Id, edition);
            }
            await dataGrid.UpdateRow(edition);
        }
    }
    async Task CancelEdit(EditionDto edition)
    {
        if (edition.Id == Guid.Empty)
        {
            editions.Remove(edition);
            await dataGrid.Reload();
        }
        else
        {
            var OldEdition = await editionService.GetByIdAsync(edition.Id);
            if (OldEdition != null)
            {
                edition.RSWStartDate = OldEdition.RSWStartDate;
                edition.LSWStartDate = OldEdition.LSWStartDate;
                edition.Theme = OldEdition.Theme;
                
                await dataGrid.UpdateRow(edition);
                dataGrid.CancelEditRow(edition);
            }
        }
    }
    async Task ActivateEdition(EditionDto edition){
        await editionService.ActivateAsync(edition.Id);
    }
    async Task OpenDialog(EditionDto edition){
        await DialogService.OpenAsync<EditionDialog>("Edit Edition", new Dictionary<string, object> { { "edition", edition } });
    }
}
