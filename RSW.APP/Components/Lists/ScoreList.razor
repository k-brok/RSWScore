@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IPatrolService patrolService
@inject ICriteriaService criteriaService
@if(patrols == null || criterias == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@scores" TItem="Score" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="Score" Property="PatrolId" Title="Patrouille">
                <Template Context="score">
                    @patrols.FirstOrDefault(C => C.Id == score.PatrolId).Name
                </Template>
                <EditTemplate Context="score">
                    <RadzenFormField Text="Patrouille" Style="width:100%">
                        <RadzenDropDown Data="@patrols" @bind-Value=score.PatrolId ValueProperty=@nameof(Patrol.Id) TextProperty=@nameof(Patrol.Name) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Score" Property="CriteriaId" Title="criteria">
                <Template Context="score">
                    @criterias.FirstOrDefault(C => C.Id == score.CriteriaId).Name
                </Template>
                <EditTemplate Context="score">
                    <RadzenFormField Text="criteria" Style="width:100%">
                        <RadzenDropDown Data="@criterias" @bind-Value=score.CriteriaId ValueProperty=@nameof(Criteria.Id) TextProperty=@nameof(Criteria.Name) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Score" Property="Value" Title="score" >
                <EditTemplate Context="score">
                    <RadzenFormField Text="score" Style="width:100%">
                        <RadzenNumeric @bind-Value="@score.Value" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="score">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(score))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(score))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(score))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="score">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(score))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(score))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(score))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Parameter]
    public List<Score> scores { get; set; } = new List<Score>();
    public List<Score> NewScores { get; set; } = new List<Score>();
    public EventCallback<Score> OnScoreSelected { get; set; }
    private RadzenDataGrid<Score> dataGrid;
    private IEnumerable<Patrol>? patrols { get; set; } = null;
    private IEnumerable<Criteria>? criterias { get; set; } = null;

    [Inject]
    private IScoreService scoreService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        patrols = await patrolService.GetAllAsync();
        criterias = await criteriaService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(Score score)
    {
        if (OnScoreSelected.HasDelegate)
        {
            await OnScoreSelected.InvokeAsync(score);
        }
    }
    void Insert()
    {
        var NewScore = new Score();
        dataGrid.InsertRow(NewScore);
    }
    void InsertAfterRow(Score score)
    {
        var NewScore = new Score();
        dataGrid.InsertAfterRow(NewScore, score);
    }
    void EditRow(Score score)
    {
        dataGrid.EditRow(score);
    }
    async Task DeleteRow(Score score)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{score.Id}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (score.Id != Guid.Empty)
            {
                await scoreService.DeleteAsync(score.Id);
            }
            scores.Remove(score);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(Score score)
    {
        if (score.Id == Guid.Empty)
        {
            await scoreService.CreateAsync(new Score
            {
                CriteriaId = score.CriteriaId,
                PatrolId = score.PatrolId,
                Value = score.Value
            });
        }
        else
        {
            await scoreService.UpdateAsync(score.Id, score);
        }
        await dataGrid.UpdateRow(score);
    }
    async Task SaveAll()
    {
        foreach (Score score in scores)
        {
            if (score.Id == Guid.Empty)
            {
                await scoreService.CreateAsync(new Score
                    {
                        CriteriaId = score.CriteriaId,
                        PatrolId = score.PatrolId,
                        Value = score.Value
                    });
            }
            else
            {
                await scoreService.UpdateAsync(score.Id, score);
            }
            await dataGrid.UpdateRow(score);
        }
    }
    async Task CancelEdit(Score score)
    {
        if (score.Id == Guid.Empty)
        {
            scores.Remove(score);
            await dataGrid.Reload();
        }
        else
        {
            var OldScore = await scoreService.GetByIdAsync(score.Id);
            if (OldScore != null)
            {
                score.CriteriaId = OldScore.CriteriaId;
                score.PatrolId = OldScore.PatrolId;
                score.Value = OldScore.Value;
                
                await dataGrid.UpdateRow(score);
                dataGrid.CancelEditRow(score);
            }
        }
    }
}
