@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IPatrolService patrolService
@if(patrolDtos == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@scouts" TItem="ScoutDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="ScoutDto" Property="Firstname" Title="Voornaam" >
                <EditTemplate Context="scout">
                    <RadzenFormField Text="Voornaam" Style="width:100%">
                        <RadzenTextBox @bind-Value="@scout.Firstname" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ScoutDto" Property="Lastname" Title="Achternaam" >
                <EditTemplate Context="scout">
                    <RadzenFormField Text="Achternaam" Style="width:100%">
                        <RadzenTextBox @bind-Value="@scout.Lastname" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ScoutDto" Property="DateOfBirth" Title="Geboorte datum" >
                <EditTemplate Context="scout">
                    <RadzenFormField Text="Geboorte datum" Style="width:100%">
                        <RadzenDatePicker @bind-Value="@scout.DateOfBirth" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ScoutDto" Property="PatrolId" Title="Patrouille">
                <Template Context="score">
                    @patrolDtos.FirstOrDefault(C => C.Id == score.PatrolId).Name
                </Template>
                <EditTemplate Context="score">
                    <RadzenFormField Text="Patrouille" Style="width:100%">
                        <RadzenDropDown Data="@patrolDtos" @bind-Value=score.PatrolId ValueProperty=@nameof(PatrolDto.Id) TextProperty=@nameof(PatrolDto.Name) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="scout">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(scout))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(scout))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(scout))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="scout">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(scout))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(scout))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(scout))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Parameter]
    public List<ScoutDto> scouts { get; set; } = new List<ScoutDto>();
    public List<ScoutDto> NewScouts { get; set; } = new List<ScoutDto>();
    public EventCallback<ScoutDto> OnScoutDtoSelected { get; set; }
    private RadzenDataGrid<ScoutDto> dataGrid;
    private IEnumerable<PatrolDto>? patrolDtos { get; set; } = null;

    [Inject]
    private IScoutService scoutService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        patrolDtos = await patrolService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(ScoutDto scout)
    {
        if (OnScoutDtoSelected.HasDelegate)
        {
            await OnScoutDtoSelected.InvokeAsync(scout);
        }
    }
    void Insert()
    {
        var NewScout = new ScoutDto();
        dataGrid.InsertRow(NewScout);
    }
    void InsertAfterRow(ScoutDto scout)
    {
        var NewScout = new ScoutDto();
        dataGrid.InsertAfterRow(NewScout, scout);
    }
    void EditRow(ScoutDto scout)
    {
        dataGrid.EditRow(scout);
    }
    async Task DeleteRow(ScoutDto scout)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{scout.Firstname} {scout.Lastname}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (scout.Id != Guid.Empty)
            {
                await scoutService.DeleteAsync(scout.Id);
            }
            scouts.Remove(scout);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(ScoutDto scout)
    {
        if (scout.Id == Guid.Empty)
        {
            await scoutService.CreateAsync(new ScoutCreateDto
            {
                Firstname = scout.Firstname,
                Lastname = scout.Lastname,
                PatrolId = scout.PatrolId,
                DateOfBirth = scout.DateOfBirth
            });
        }
        else
        {
            await scoutService.UpdateAsync(scout.Id, scout);
        }
        await dataGrid.UpdateRow(scout);
    }
    async Task SaveAll()
    {
        foreach (ScoutDto scout in scouts)
        {
            if (scout.Id == Guid.Empty)
            {
                await scoutService.CreateAsync(new ScoutCreateDto
                    {
                        Firstname = scout.Firstname,
                        Lastname = scout.Lastname,
                        PatrolId = scout.PatrolId,
                        DateOfBirth = scout.DateOfBirth
                    });
            }
            else
            {
                await scoutService.UpdateAsync(scout.Id, scout);
            }
            await dataGrid.UpdateRow(scout);
        }
    }
    async Task CancelEdit(ScoutDto scout)
    {
        if (scout.Id == Guid.Empty)
        {
            scouts.Remove(scout);
            await dataGrid.Reload();
        }
        else
        {
            var OldScout = await scoutService.GetByIdAsync(scout.Id);
            if (OldScout != null)
            {
                scout.Firstname = OldScout.Firstname;
                scout.Lastname = OldScout.Lastname;
                scout.PatrolId = OldScout.PatrolId;
                scout.DateOfBirth = OldScout.DateOfBirth;
                
                await dataGrid.UpdateRow(scout);
                dataGrid.CancelEditRow(scout);
            }
        }
    }
}
