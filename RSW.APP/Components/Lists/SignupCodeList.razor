@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IGroupService groupService
@if(groups == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@signupcodes" TItem="SignupCode" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="SignupCode" Property="Id" Title="Code" >
                <Template Context="signupcode">
                    @if(signupcode.Id == Guid.Empty){
                        <p>Nog niet gegenereerd.</p>
                    }
                    else
                    {
                        @signupcode.Id
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SignupCode" Property="GroupId" Title="Groep">
                <Template Context="signupcode">
                    @groups.FirstOrDefault(C => C.Id == signupcode.GroupId).Name
                </Template>
                <EditTemplate Context="signupcode">
                    <RadzenFormField Text="Groep" Style="width:100%">
                        <RadzenDropDown Data="@groups" @bind-Value=signupcode.GroupId ValueProperty=@nameof(Group.Id)>
                            <Template>
                                @((context as Group).Name)
                            </Template>
                        </RadzenDropDown>
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SignupCode" Property="Lock" Title="Lock" >
                <Template Context="signupcode">
                    @if(signupcode.Lock){
                        <p>Geblokkeerd</p>
                    }
                    else
                    {
                        <p>Actief</p>
                    }
                </Template>
                <EditTemplate Context="signupcode">
                    <RadzenButton Text="Lock" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SignupCode" Property="ExpiryDate" Title="Vervaldatum" >
                <EditTemplate Context="signupcode">
                    <RadzenFormField Text="Vervaldatum" Style="width:100%">
                        <RadzenDatePicker @bind-Value="@signupcode.ExpiryDate" />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="signupcode">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(signupcode))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(signupcode))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(signupcode))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="signupcode">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(signupcode))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(signupcode))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(signupcode))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Parameter]
    public List<SignupCode> signupcodes { get; set; } = new List<SignupCode>();
    public List<SignupCode> NewSignupCodes { get; set; } = new List<SignupCode>();
    public EventCallback<SignupCode> OnSignupCodeSelected { get; set; }
    private RadzenDataGrid<SignupCode> dataGrid;
    private IEnumerable<Group>? groups { get; set; } = null;

    [Inject]
    private ISignupCodeService signupcodeService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        groups = await groupService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(SignupCode signupcode)
    {
        if (OnSignupCodeSelected.HasDelegate)
        {
            await OnSignupCodeSelected.InvokeAsync(signupcode);
        }
    }
    void Insert()
    {
        var NewSignupCode = new SignupCode();
        dataGrid.InsertRow(NewSignupCode);
    }
    void InsertAfterRow(SignupCode signupcode)
    {
        var NewSignupCode = new SignupCode();
        dataGrid.InsertAfterRow(NewSignupCode, signupcode);
    }
    void EditRow(SignupCode signupcode)
    {
        dataGrid.EditRow(signupcode);
    }
    async Task DeleteRow(SignupCode signupcode)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{signupcode.Id}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (signupcode.Id != Guid.Empty)
            {
                await signupcodeService.DeleteAsync(signupcode.Id);
            }
            signupcodes.Remove(signupcode);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(SignupCode signupcode)
    {
        if (signupcode.Id == Guid.Empty)
        {
            var NeCode = await signupcodeService.CreateAsync(new SignupCodeCreate
            {
                GroupId = signupcode.GroupId,
            });
            signupcode.Id = NeCode.Id;
        }
        else
        {
            await signupcodeService.UpdateAsync(signupcode.Id, signupcode);
        }
        await dataGrid.UpdateRow(signupcode);
    }
    async Task SaveAll()
    {
        foreach (SignupCode signupcode in signupcodes)
        {
            if (signupcode.Id == Guid.Empty)
            {
                await signupcodeService.CreateAsync(new SignupCodeCreate
                    {
                        GroupId = signupcode.GroupId,
                    });
            }
            else
            {
                await signupcodeService.UpdateAsync(signupcode.Id, signupcode);
            }
            await dataGrid.UpdateRow(signupcode);
        }
    }
    async Task CancelEdit(SignupCode signupcode)
    {
        if (signupcode.Id == Guid.Empty)
        {
            signupcodes.Remove(signupcode);
            await dataGrid.Reload();
        }
        else
        {
            var OldSignupCode = await signupcodeService.GetByIdAsync(signupcode.Id);
            if (OldSignupCode != null)
            {
                signupcode.GroupId = OldSignupCode.GroupId;
                signupcode.ExpiryDate = OldSignupCode.ExpiryDate;
                
                await dataGrid.UpdateRow(signupcode);
                dataGrid.CancelEditRow(signupcode);
            }
        }
    }
}
