@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IEditionService editionService

<RadzenDataGrid @ref="dataGrid" Data="@subgroups" TItem="SubGroupDto" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
    <Columns>
        <RadzenDataGridColumn TItem="SubGroupDto" Property="Color" Title="Color" >
            <EditTemplate Context="subgroup">
                <RadzenFormField Text="Kleur" Style="width:100%">
                    <RadzenTextBox @bind-Value="@subgroup.Color" />
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="SubGroupDto" Property="EditionId" Title="Editie">
            <Template Context="subgroup">
                @editionDtos.FirstOrDefault(C => C.Id == subgroup.EditionId).RSWStartDate.Year
            </Template>
            <EditTemplate Context="subgroup">
                <RadzenFormField Text="Editie" Style="width:100%">
                    <RadzenDropDown Data="@editionDtos" @bind-Value=subgroup.EditionId ValueProperty=@nameof(EditionDto.Id)>
                        <Template>
                            @((context as EditionDto).RSWStartDate.Year)
                        </Template>
                    </RadzenDropDown>
                </RadzenFormField>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
            <HeaderTemplate>
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
            </HeaderTemplate>
            <Template Context="subgroup">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(subgroup))" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(subgroup))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(subgroup))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="subgroup">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(subgroup))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(subgroup))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(subgroup))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<SubGroupDto> subgroups { get; set; } = new List<SubGroupDto>();
    public List<SubGroupDto> NewSubGroups { get; set; } = new List<SubGroupDto>();
    public EventCallback<SubGroupDto> OnSubGroupDtoSelected { get; set; }
    private RadzenDataGrid<SubGroupDto> dataGrid;
    private IEnumerable<EditionDto> editionDtos { get; set; } = new List<EditionDto>();


    [Inject]
    private ISubGroupService subgroupService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        editionDtos = await editionService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(SubGroupDto subgroup)
    {
        if (OnSubGroupDtoSelected.HasDelegate)
        {
            await OnSubGroupDtoSelected.InvokeAsync(subgroup);
        }
    }
    void Insert()
    {
        var NewSubGroup = new SubGroupDto();
        dataGrid.InsertRow(NewSubGroup);
    }
    void InsertAfterRow(SubGroupDto subgroup)
    {
        var NewSubGroup = new SubGroupDto();
        dataGrid.InsertAfterRow(NewSubGroup, subgroup);
    }
    void EditRow(SubGroupDto subgroup)
    {
        dataGrid.EditRow(subgroup);
    }
    async Task DeleteRow(SubGroupDto subgroup)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{subgroup.Color}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (subgroup.Id != Guid.Empty)
            {
                await subgroupService.DeleteAsync(subgroup.Id);
            }
            subgroups.Remove(subgroup);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(SubGroupDto subgroup)
    {
        if (subgroup.Id == Guid.Empty)
        {
            await subgroupService.CreateAsync(new SubGroupCreateDto
            {
                Color = subgroup.Color,
                EditionId = subgroup.EditionId
            });
        }
        else
        {
            await subgroupService.UpdateAsync(subgroup.Id, subgroup);
        }
        await dataGrid.UpdateRow(subgroup);
    }
    async Task SaveAll()
    {
        foreach (SubGroupDto subgroup in subgroups)
        {
            if (subgroup.Id == Guid.Empty)
            {
                await subgroupService.CreateAsync(new SubGroupCreateDto
                    {
                        Color = subgroup.Color,
                        EditionId = subgroup.EditionId
                    });
            }
            else
            {
                await subgroupService.UpdateAsync(subgroup.Id, subgroup);
            }
            await dataGrid.UpdateRow(subgroup);
        }
    }
    async Task CancelEdit(SubGroupDto subgroup)
    {
        if (subgroup.Id == Guid.Empty)
        {
            subgroups.Remove(subgroup);
            await dataGrid.Reload();
        }
        else
        {
            var OldSubGroup = await subgroupService.GetByIdAsync(subgroup.Id);
            if (OldSubGroup != null)
            {
                subgroup.Color = OldSubGroup.Color;
                subgroup.EditionId = OldSubGroup.EditionId;
                
                await dataGrid.UpdateRow(subgroup);
                dataGrid.CancelEditRow(subgroup);
            }
        }
    }
}
