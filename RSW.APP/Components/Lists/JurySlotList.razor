@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ISubGroupService subGroupService
@inject ICategoryService categoryService
@inject NavigationManager Nav

@if(categorys == null || subGroups == null){
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Data ophalen...</p>
    </RadzenCard>
}
else
{
    <RadzenDataGrid @ref="dataGrid" Data="@juryslots" TItem="JurySlot" RowSelect="@OnRowSelect" AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="height: 600px;">
        <Columns>
            <RadzenDataGridColumn TItem="JurySlot" Property="Id" Title="Code" >
                <Template Context="jurySlot">
                    @if(jurySlot.Id == Guid.Empty){
                        <p>Nog niet gegenereerd.</p>
                    }
                    else
                    {
                        <RadzenButton Variant="Variant.Text" Click=@(args => Nav.NavigateTo($"/JuryForm?Code={jurySlot.Id.ToString()}")) Text=@jurySlot.Id.ToString() />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="JurySlot" Property="CategoryId" Title="Categorie">
                <Template Context="jurySlot">
                    @categorys.FirstOrDefault(C => C.Id == jurySlot.CategoryId).Name
                </Template>
                <EditTemplate Context="jurySlot">
                    <RadzenFormField Text="Categorie" Style="width:100%">
                        <RadzenDropDown Data="@categorys" @bind-Value=jurySlot.CategoryId ValueProperty=@nameof(Category.Id) TextProperty=@nameof(Category.Name) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="JurySlot" Property="SubgroupId" Title="Sub-kamp">
                <Template Context="jurySlot">
                    @subGroups.FirstOrDefault(C => C.Id == jurySlot.SubgroupId).Color
                </Template>
                <EditTemplate Context="jurySlot">
                    <RadzenFormField Text="sub-kamp" Style="width:100%">
                        <RadzenDropDown Data="@subGroups" @bind-Value=jurySlot.SubgroupId ValueProperty=@nameof(SubGroup.Id) TextProperty=@nameof(SubGroup.Color) />
                    </RadzenFormField>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="10rem" FrozenPosition="FrozenColumnPosition.Right">
                <HeaderTemplate>
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-display-none rz-display-sm-inline" Click="@((args) => SaveAll())" aria-label="SaveAll" />
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-me-4 rz-display-none rz-display-sm-inline" Shade="Shade.Lighter" Click="@(() => Insert())" />
                </HeaderTemplate>
                <Template Context="juryslot">
                    <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(juryslot))" />
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(juryslot))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(juryslot))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="juryslot">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(juryslot))" aria-label="Save" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(juryslot))" aria-label="Cancel" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1 rz-me-4" Click="@(args => DeleteRow(juryslot))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
@code {
    [Parameter]
    public List<JurySlot> juryslots { get; set; } = new List<JurySlot>();
    public EventCallback<JurySlot> OnJurySlotSelected { get; set; }
    private RadzenDataGrid<JurySlot> dataGrid;
    private IEnumerable<Category>? categorys { get; set; } = null;
    private IEnumerable<SubGroup>? subGroups { get; set; } = null;

    [Inject]
    private IJurySlotService juryslotService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        categorys = await categoryService.GetAllAsync();
        subGroups = await subGroupService.GetAllAsync();
        await base.OnInitializedAsync();
    }
    private async Task OnRowSelect(JurySlot juryslot)
    {
        if (OnJurySlotSelected.HasDelegate)
        {
            await OnJurySlotSelected.InvokeAsync(juryslot);
        }
    }
    void Insert()
    {
        var NewJurySlot = new JurySlot();
        dataGrid.InsertRow(NewJurySlot);
    }
    void InsertAfterRow(JurySlot juryslot)
    {
        var NewJurySlot = new JurySlot();
        dataGrid.InsertAfterRow(NewJurySlot, juryslot);
    }
    void EditRow(JurySlot juryslot)
    {
        dataGrid.EditRow(juryslot);
    }
    async Task DeleteRow(JurySlot juryslot)
    {
        var ConfirmDelete = await DialogService.Confirm($"Weet je zeker dat je \"{juryslot.Id}\" wilt verwijderen?", "Verwijderen", new ConfirmOptions() { OkButtonText = "Ja", CancelButtonText = "Nee" });
        if (ConfirmDelete == null)
        {
            NotificationService.Notify(new NotificationMessage{ Summary="Er is iets mis gegaan! neem contact op met een admin." });
            return;
        }

        if ((bool)ConfirmDelete)
        {
            if (juryslot.Id != Guid.Empty)
            {
                await juryslotService.DeleteAsync(juryslot.Id);
            }
            juryslots.Remove(juryslot);
            await dataGrid.Reload();
        }
    }
    async Task SaveRow(JurySlot juryslot)
    {
        if (juryslot.Id == Guid.Empty)
        {
            var NewJurySlot = await juryslotService.CreateAsync(new JurySlot
            {
                CategoryId = juryslot.CategoryId,
                SubgroupId = juryslot.SubgroupId,
                ClosingTime = juryslot.ClosingTime,
                OpeningTime = juryslot.OpeningTime
            });
            if(NewJurySlot != null)
                juryslot.Id = NewJurySlot.Id;
        }
        else
        {
            await juryslotService.UpdateAsync(juryslot.Id, juryslot);
        }
        await dataGrid.UpdateRow(juryslot);
    }
    async Task SaveAll()
    {
        foreach (JurySlot juryslot in juryslots)
        {
            if (juryslot.Id == Guid.Empty)
            {
                await juryslotService.CreateAsync(new JurySlot
                    {
                        CategoryId = juryslot.CategoryId,
                        SubgroupId = juryslot.SubgroupId,
                        ClosingTime = juryslot.ClosingTime,
                        OpeningTime = juryslot.OpeningTime
                    });
            }
            else
            {
                await juryslotService.UpdateAsync(juryslot.Id, juryslot);
            }
            await dataGrid.UpdateRow(juryslot);
        }
    }
    async Task CancelEdit(JurySlot juryslot)
    {
        if (juryslot.Id == Guid.Empty)
        {
            juryslots.Remove(juryslot);
            await dataGrid.Reload();
        }
        else
        {
            var OldJurySlot = await juryslotService.GetByIdAsync(juryslot.Id);
            if (OldJurySlot != null)
            {
                juryslot.CategoryId = OldJurySlot.CategoryId;
                juryslot.SubgroupId = OldJurySlot.SubgroupId;
                juryslot.ClosingTime = OldJurySlot.ClosingTime;
                juryslot.OpeningTime = OldJurySlot.OpeningTime;
                
                await dataGrid.UpdateRow(juryslot);
                dataGrid.CancelEditRow(juryslot);
            }
        }
    }
}
