@using RSW.Shared.Dto
@using Radzen
@inject NotificationService notificationService
@inject RSW.APP.Services.AuthService AuthService

<RadzenTemplateForm Data="@resetPasswordModel" Submit="@OnSubmit" TItem="ResetPasswordRequest">
    <RadzenFieldset>
        <!-- Email -->
        @if (ShowEmailField || string.IsNullOrWhiteSpace(resetPasswordModel.Email))
        {
            <RadzenLabel Text="Email" />
            <RadzenTextBox @bind-Value="resetPasswordModel.Email" Name="Email" Style="width: 100%;" />
            <RadzenDataAnnotationValidator Component="Email" Popup="true" Style="position: absolute;" />
        }

        <!-- Token -->
        @if (ShowTokenField || string.IsNullOrWhiteSpace(resetPasswordModel.Token))
        {
            <RadzenLabel Text="Token" Style="margin-top: 20px;" />
            <RadzenTextBox @bind-Value="resetPasswordModel.Token" Name="Token" Style="width: 100%;" />
            <RadzenDataAnnotationValidator Component="Token" Popup="true" Style="position: absolute;" />
        }

        <!-- Nieuw wachtwoord -->
        <RadzenLabel Text="Nieuw wachtwoord" Style="margin-top: 20px;" />
        <RadzenPassword @bind-Value="resetPasswordModel.NewPassword" Name="NewPassword" Style="width: 100%;" />
        <RadzenDataAnnotationValidator Component="NewPassword" Popup="true" Style="position: absolute;" />

        <!-- Bevestig nieuw wachtwoord -->
        <RadzenLabel Text="Bevestig nieuw wachtwoord" Style="margin-top: 20px;" />
        <RadzenPassword @bind-Value="confirmPassword" Name="ConfirmPassword" Style="width: 100%;" />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <RadzenAlert Severity="AlertSeverity.Error" Style="margin-top: 20px;">
                @ErrorMessage
            </RadzenAlert>
        }

        <!-- Submit knop -->
        <RadzenButton Text="Wachtwoord resetten" ButtonType="ButtonType.Submit" Style="margin-top: 20px; width: 100%;" />
    </RadzenFieldset>
</RadzenTemplateForm>

@code {
    private ResetPasswordRequest resetPasswordModel = new();
    private string confirmPassword = string.Empty;

    [Parameter] public bool ShowEmailField { get; set; } = false;    // Toon email veld ja/nee
    [Parameter] public bool ShowTokenField { get; set; } = false;    // Toon token veld ja/nee
    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public string? Email
    {
        get => resetPasswordModel.Email;
        set => resetPasswordModel.Email = value;
    }

    [Parameter] public string? Token
    {
        get => resetPasswordModel.Token;
        set => resetPasswordModel.Token = value;
    }

    [Parameter] public EventCallback OnResetPasswordSuccess { get; set; }
    [Parameter] public EventCallback<string> OnResetPasswordFailed { get; set; }

    private async Task OnSubmit()
    {
        if (resetPasswordModel.NewPassword != confirmPassword)
        {
            ErrorMessage = "Wachtwoord en bevestiging komen niet overeen.";
            return;
        }

        var result = await AuthService.ResetPasswordAsync(resetPasswordModel);

        if (result)
        {
            await OnResetPasswordSuccess.InvokeAsync();
            notificationService.Notify(new NotificationMessage
            {
                Summary = "Succes",
                Detail = "Wachtwoord succesvol gereset.",
                Severity = NotificationSeverity.Success
            });
        }
        else
        {
            ErrorMessage = "Wachtwoord reset mislukt.";
            await OnResetPasswordFailed.InvokeAsync(ErrorMessage);
            notificationService.Notify(new NotificationMessage
            {
                Summary = "Fout",
                Detail = ErrorMessage,
                Severity = NotificationSeverity.Error
            });
        }
    }
}
