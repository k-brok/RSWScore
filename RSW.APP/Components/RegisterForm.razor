@using RSW.Domain.Entities
@using Radzen
@inject NotificationService notificationService
@inject RSW.APP.Application.Services.AuthService AuthService

<RadzenTemplateForm Data="@registerModel" Submit="@OnSubmit" TItem="RegisterRequest">

    <RadzenFieldset>

        <!-- Email -->
        <RadzenLabel Text="Email" />
        <RadzenTextBox @bind-Value="registerModel.Email" Name="Email" Style="width: 100%;" />
        <RadzenDataAnnotationValidator Component="Email" Popup="true" Style="position: absolute;" />

        <!-- Wachtwoord -->
        <RadzenLabel Text="Wachtwoord" Style="margin-top: 20px;" />
        <RadzenPassword @bind-Value="registerModel.Password" Name="Password" Style="width: 100%;" />
        <RadzenDataAnnotationValidator Component="Password" Popup="true" Style="position: absolute;" />

        <!-- Bevestig wachtwoord -->
        <RadzenLabel Text="Bevestig wachtwoord" Style="margin-top: 20px;" />
        <RadzenPassword @bind-Value="registerModel.ConfirmPassword" Name="ConfirmPassword" Style="width: 100%;" />
        <RadzenDataAnnotationValidator Component="ConfirmPassword" Popup="true" Style="position: absolute;" />

        <!-- Foutmelding -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <RadzenAlert Severity="AlertSeverity.Error" Style="margin-top: 20px;">
                @ErrorMessage
            </RadzenAlert>
        }

        <!-- Submitknop -->
        <RadzenButton Text="Registreren" ButtonType="ButtonType.Submit" Style="margin-top: 20px; width: 100%;" />
    </RadzenFieldset>
</RadzenTemplateForm>

@code {
    private RegisterRequest registerModel = new();
    [Parameter] public EventCallback<RegisterResponse> OnRegisterSuccess { get; set; }
    [Parameter] public EventCallback<string> OnRegisterFailed { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private async Task OnSubmit()
    {
        var result = await AuthService.RegisterAsync(registerModel, false);

        if (result != null)
        {
            await OnRegisterSuccess.InvokeAsync(result);
        }
        else
        {
            await OnRegisterFailed.InvokeAsync("Registratie mislukt.");
        }
    }
}
