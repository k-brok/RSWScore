@page "/signup/{id:guid}"
@page "/signup"

@using RSW.Domain.Entities
@inject ISignupCodeService SignupCodeService
@inject IUnitService UnitService
@inject IAssociationService AssociationService
@inject IPatrolService PatrolService
@inject IEditionService EditionService
@inject ISubGroupService subGroupService
@inject IScoutService scoutService
@inject IUserService UserService
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Nav

<PageTitle>Inschrijven</PageTitle>

@if (!loaded)
{
    <RadzenCard Style="margin:20px;">
        <RadzenProgressBarCircular Value="50" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p>Gegevens laden...</p>
    </RadzenCard>
}
else if (!HasAccess)
{
    <RadzenCard Style="margin:20px;">
        <p>Om in te schrijven heb je een inschrijfcode nodig, vul deze hieronder in om de inschrijving te openen.</p>

        <div class="rz-p-fluid rz-form-group" style="display:grid;grid-template-columns:1fr auto;gap:.5rem;max-width:520px;">
            <RadzenTextBox @bind-Value=InsertCode Style="width:100%;" />
            <RadzenButton Text="Open inschrijving" Click="@(() => OpenSignup(InsertCode))" Icon="login" />
        </div>

        @* Ingelogd, maar geen UnitId (Groep) & nog geen geldige code: toon informatieve melding met aanvraagknop *@
        @if (IsLoggedInWithoutUnit)
        {
            <RadzenAlert Severity="AlertSeverity.Info" Style="margin-top:12px;">
                Je account is nog niet gekoppeld aan een <b>Groep</b>. Je kunt bij de organisatie een koppeling aanvragen.
            </RadzenAlert>

            <RadzenButton Text="Koppeling met Groep aanvragen"
                          Icon="mail"
                          ButtonStyle="ButtonStyle.Secondary"
                          Style="margin-top:8px;"
                          Click="@OpenLinkDialogWithoutUnitAsync" />
        }
    </RadzenCard>
}
else if (ActiveEdition == null)
{
    <RadzenCard Style="margin:20px;">
        <h3>🚫 Geen actieve editie.</h3>
        <p>Neem contact op met de organisatie.</p>
    </RadzenCard>
}
else
{
    <RadzenCard Style="margin:20px;">
        @* Waarschuwing: presignup voorbij & geen patrouilles *@
        @if (NoPatrolsAfterClose)
        {
            <RadzenAlert Severity="AlertSeverity.Warning" Style="margin-bottom:12px;">
                De voorinschrijvingsperiode is gesloten en er zijn geen patrouilles ingeschreven voor deze Groep.
                Inschrijven is momenteel niet mogelijk. Neem contact op met de organisatie.
            </RadzenAlert>
        }

        @* Ingelogd zonder UnitId, maar we hebben toegang via inschrijfcode en Unit context is bekend *@
        @if (IsLoggedInWithoutUnit && HasSignupCode && Unit != null)
        {
            <RadzenAlert Severity="AlertSeverity.Warning" Style="margin-bottom:12px;">
                Je bent ingelogd maar nog niet gekoppeld aan <b>@Unit.Name @Association?.Name</b>.
                Wil je aan deze Groep gekoppeld worden? Dien een aanvraag in bij de organisatie.
            </RadzenAlert>

            <RadzenButton Text="Koppel mij aan deze Groep"
                          Icon="mail"
                          ButtonStyle="ButtonStyle.Secondary"
                          Style="margin-bottom:16px;"
                          Click="@OpenLinkDialogWithCurrentUnitAsync" />
        }

        <h2>Inschrijfformulier RSW @ActiveEdition.RSWStartDate.Year ⚜️</h2>
        <p>Voor groep: <b>@Unit?.Name @Association?.Name</b></p>

        <h4 style="margin-top:20px;">Patrouilles</h4>

        @if (IsinPresignup)
        {
            <RadzenButton Text="Patrouille toevoegen"
                          Click="@AddPatrol"
                          ButtonStyle="ButtonStyle.Light"
                          Icon="add"
                          Style="margin-bottom:10px;" />
        }

        <RadzenDataList Data="@ExistingPatrol.Concat(newpatrols)" TItem="Patrol">
            <Template Context="patrol">
                @if (IsinPresignup)
                {
                    <RadzenTable>
                        <RadzenTableHeader>
                            <RadzenTableHeaderRow>
                                <RadzenTableHeaderCell>
                                    <RadzenLabel Text="Patrouille naam" Component="PatrolName" />
                                </RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>
                                    <RadzenLabel Text="Jongste patrouille?" Component="IsYoungest" />
                                </RadzenTableHeaderCell>
                                <RadzenTableHeaderCell rowspan="2">
                                    @if (toRemove.Contains(patrol))
                                    {
                                        <RadzenButton Text="Reset"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Icon="undo"
                                                      Click="@(() => toRemove.Remove(patrol))"
                                                      Style="margin-top:10px;" />
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Verwijderen"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Icon="delete"
                                                      Click="@(() => toRemove.Add(patrol))"
                                                      Style="margin-top:10px;" />
                                    }
                                </RadzenTableHeaderCell>
                            </RadzenTableHeaderRow>
                            <RadzenTableHeaderRow>
                                <RadzenTableHeaderCell>
                                    <RadzenTextBox @bind-Value="patrol.Name" Name="PatrolName" Placeholder="Patrouillenaam" Style="width:100%;" />
                                </RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>
                                    <RadzenCheckBox @bind-Value="patrol.IsYoungest" Name="IsYoungest" Disabled="@toRemove.Contains(patrol)" />
                                </RadzenTableHeaderCell>
                            </RadzenTableHeaderRow>
                        </RadzenTableHeader>
                    </RadzenTable>
                }
                else
                {
                    <h2>@patrol.Name</h2>
                    <RadzenTable>
                        <RadzenTableHeader>
                            <RadzenTableHeaderRow>
                                <RadzenTableHeaderCell>Nummer</RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>Sub-kamp</RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>Voldoet aan deelnemerseisen</RadzenTableHeaderCell>
                                <RadzenTableHeaderCell rowspan="2">
                                    @if (patrol.IsYoungest)
                                    {
                                        <p>jongste</p>
                                    }
                                </RadzenTableHeaderCell>
                            </RadzenTableHeaderRow>
                            <RadzenTableHeaderRow>
                                <RadzenTableHeaderCell>@patrol.Number</RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>
                                    @{
                                        var sub = patrol.SubGroupId.HasValue
                                            ? SubGroups.FirstOrDefault(S => S.Id == patrol.SubGroupId.Value)
                                            : null;
                                    }
                                    @sub?.Color
                                </RadzenTableHeaderCell>
                                <RadzenTableHeaderCell>
                                    @if (ActiveEdition != null && patrol.unranked((DateOnly)(ActiveEdition.LSWStartDate ?? ActiveEdition.RSWStartDate)))
                                    {
                                        <p>nee</p>
                                    }
                                    else
                                    {
                                        <p>ja</p>
                                    }
                                </RadzenTableHeaderCell>
                            </RadzenTableHeaderRow>
                        </RadzenTableHeader>
                    </RadzenTable>

                    <RadzenDataGrid @ref=ScoutsLists[patrol]
                                    Data="@patrol.Scouts"
                                    TItem="Scout"
                                    AllowPaging="false"
                                    AllowSorting="false"
                                    RowRender="@RowRender"
                                    ondragover="event.preventDefault()"
                                    @ondrop=@(args => Move(patrol))>
                        <Columns>
                            @RenderColumns(patrol)
                        </Columns>
                    </RadzenDataGrid>
                }
            </Template>
        </RadzenDataList>

        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Inschrijven"
                      Icon="send" Style="margin-top:15px;" Click="OnSubmit" />
    </RadzenCard>
}

@code {
    [Parameter] public Guid? id { get; set; } = null;

    private string InsertCode { get; set; }
    private bool loaded = false;
    private bool IsinPresignup = true;

    private SignupCode? signupCode;
    private ApplicationUser? CurrentUser;

    private Unit Unit;
    private Edition? ActiveEdition;
    private Association? Association;

    private List<Patrol> newpatrols = new();
    private List<Patrol> ExistingPatrol = new();   // nooit null
    private List<Patrol> toRemove = new();

    private IEnumerable<SubGroup> SubGroups = new List<SubGroup>();
    private Dictionary<Patrol, RadzenDataGrid<Scout>> ScoutsLists = new();
    private Dictionary<Patrol, List<Scout>> DeleteScoutsLists = new();

    // Toegangsvlaggen
    private Guid? EffectiveUnitId = null;                  // Unit uit user of uit code
    private bool HasAccess => EffectiveUnitId != null || signupCode != null;
    private bool HasSignupCode => signupCode != null;
    private bool IsLoggedInWithoutUnit => CurrentUser != null && (CurrentUser.UnitId == null || CurrentUser.UnitId == Guid.Empty);
    private bool NoPatrolsAfterClose => !IsinPresignup && (ExistingPatrol?.Count ?? 0) == 0;

    protected override async Task OnInitializedAsync()
    {
        // Actieve editie & fase
        ActiveEdition = await EditionService.GetActiveAsync();
        if (ActiveEdition?.PreSignupClose != null &&
            ActiveEdition.PreSignupClose < DateOnly.FromDateTime(DateTime.Today))
        {
            IsinPresignup = false;
        }

        // Ingelogde gebruiker (WASM-patroon)
        CurrentUser = await AuthService.GetCurrentUserAsync();

        // Zet bypass via UnitId (Groep) indien aanwezig
        if (CurrentUser?.UnitId is Guid u && u != Guid.Empty)
            EffectiveUnitId = u;

        // Probeer direct te openen met context
        await OpenSignup();

        loaded = true;
    }

    private async Task OpenSignup(string Code = null!)
    {
        // Subgroepen alvast
        SubGroups = await subGroupService.GetAllAsync();

        // (a) route of handmatige code
        if (id != null || Code != null)
        {
            if (id == null && Guid.TryParse(Code, out var parsed))
                id = parsed;

            if (id != null)
            {
                signupCode = await SignupCodeService.ValidateAsync(id.Value);
                if (signupCode != null)
                {
                    EffectiveUnitId = signupCode.UnitId; // context duidelijk
                    await LoadUnitContext(signupCode.UnitId);
                    return;
                }
            }
        }

        // (b) geen/ongeldige code, maar wel UnitId via ingelogde user
        if (EffectiveUnitId != null)
        {
            await LoadUnitContext(EffectiveUnitId.Value);
            return;
        }

        // (c) anders: HasAccess blijft false → UI toont codeveld (met info/aanvraagknop indien nodig)
    }

    private async Task LoadUnitContext(Guid unitId)
    {
        Unit = await UnitService.GetByIdAsync(unitId);
        if (Unit == null) return;

        Association = await AssociationService.GetByIdAsync(Unit.AssociationId);
        ExistingPatrol = (await UnitService.GetPatrolsAsync(Unit.Id))?.ToList() ?? new List<Patrol>();

        foreach (var patrol in ExistingPatrol)
        {
            patrol.Scouts = (await PatrolService.GetScoutsAsync(patrol.Id)).ToList();
            DeleteScoutsLists[patrol] = new List<Scout>();
            if (!ScoutsLists.ContainsKey(patrol))
                ScoutsLists[patrol] = null;
        }
    }

    private void AddPatrol()
    {
        if (!HasAccess) return;
        newpatrols.Add(new Patrol());
    }

    private async Task OnSubmit()
    {
        if (!HasAccess || Unit == null) return;

        if (IsinPresignup)
        {
            // nieuwe patrouilles
            foreach (Patrol patrol in newpatrols)
            {
                await PatrolService.CreateAsync(new Patrol
                {
                    UnitId = Unit.Id,
                    Name = patrol.Name,
                    IsYoungest = patrol.IsYoungest
                });
            }
            // bestaande bijwerken
            foreach (Patrol patrol in ExistingPatrol)
            {
                await PatrolService.UpdateAsync(patrol.Id, patrol);
            }
        }
        else
        {
            // upsert & delete scouts parallel, begrensd
            var tasks = new List<Task>();
            var semaphore = new SemaphoreSlim(5);

            foreach (Patrol patrol in ExistingPatrol)
            {
                foreach (Scout scout in patrol.Scouts)
                {
                    tasks.Add(Task.Run(async () =>
                    {
                        await semaphore.WaitAsync();
                        try
                        {
                            if (scout.Id == Guid.Empty)
                            {
                                await scoutService.CreateAsync(new Scout
                                {
                                    Firstname = scout.Firstname,
                                    Lastname = scout.Lastname,
                                    DateOfBirth = scout.DateOfBirth,
                                    PatrolId = patrol.Id
                                });
                            }
                            else
                            {
                                await scoutService.UpdateAsync(scout.Id, scout);
                            }
                        }
                        finally { semaphore.Release(); }
                    }));
                }

                if (DeleteScoutsLists.TryGetValue(patrol, out var deletes))
                {
                    foreach (Scout scout in deletes)
                    {
                        tasks.Add(Task.Run(async () =>
                        {
                            await semaphore.WaitAsync();
                            try
                            {
                                if (scout.Id != Guid.Empty)
                                    await scoutService.DeleteAsync(scout.Id);
                            }
                            finally { semaphore.Release(); }
                        }));
                    }
                }
            }

            await Task.WhenAll(tasks);
        }

        NotificationService.Notify(NotificationSeverity.Success, "Success", "De inschrijving is geüpdatet.");
    }

    private void Insert(Patrol patrol, RadzenDataGrid<Scout> dataGrid)
    {
        var NewScout = new Scout();
        patrol.Scouts.Add(NewScout);
        dataGrid.InsertRow(NewScout);
    }

    private void InsertAfterRow(Patrol patrol, RadzenDataGrid<Scout> dataGrid, Scout scout)
    {
        var NewScout = new Scout();
        patrol.Scouts.Add(NewScout);
        dataGrid.InsertAfterRow(NewScout, scout);
    }

    private void DeleteRow(Patrol patrol, RadzenDataGrid<Scout> dataGrid, Scout scout)
    {
        if (!DeleteScoutsLists.ContainsKey(patrol))
            DeleteScoutsLists[patrol] = new List<Scout>();

        DeleteScoutsLists[patrol].Add(scout);
        patrol.Scouts.Remove(scout);
        dataGrid.Reload();
    }

    Scout draggedItem;
    void Move(Patrol target)
    {
        List<Patrol> GridUpdates = new();

        if (draggedItem != null && !target.Scouts.Contains(draggedItem))
        {
            foreach (Patrol patrols in ExistingPatrol)
            {
                if (patrols.Scouts.Contains(draggedItem))
                {
                    patrols.Scouts.Remove(draggedItem);
                    if (!DeleteScoutsLists.ContainsKey(patrols))
                        DeleteScoutsLists[patrols] = new List<Scout>();
                    DeleteScoutsLists[patrols].Add(draggedItem);

                    if (!GridUpdates.Contains(patrols))
                        GridUpdates.Add(patrols);
                }
            }

            draggedItem.PatrolId = target.Id;
            target.Scouts.Add(draggedItem);
        }

        if (!GridUpdates.Contains(target))
            GridUpdates.Add(target);

        foreach (Patrol updaterows in GridUpdates)
        {
            if (ScoutsLists.TryGetValue(updaterows, out var grid) && grid != null)
                grid.Reload();
        }
    }

    void RowRender(RowRenderEventArgs<Scout> args)
    {
        args.Attributes.Add("title", "Drag row to move it to the other DataGrid");
        args.Attributes.Add("style", "cursor:grab");
        args.Attributes.Add("draggable", "true");
        args.Attributes.Add("ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => draggedItem = args.Data));
    }

    RenderFragment RenderColumns(Patrol patrol)
    {
        return __builder =>
        {
            <text>
                <RadzenDataGridColumn TItem="Scout" Property="Firstname" Title="Voornaam">
                    <Template Context="scout">
                        <RadzenTextBox @bind-Value="scout.Firstname" Style="width:100%;" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Scout" Property="Lastname" Title="Achternaam">
                    <Template Context="scout">
                        <RadzenTextBox @bind-Value="scout.Lastname" Style="width:100%;" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Scout" Property="DateOfBirth" Title="Geboortedatum">
                    <Template Context="scout">
                        <RadzenDatePicker @bind-Value="scout.DateOfBirth" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Scout" Property="DateOfBirth" Title="Leeftijd op LSW">
                    <Template Context="scout">
                        @if (ActiveEdition != null)
                        {
                            @scout.CalculateAge((DateOnly)(ActiveEdition.LSWStartDate ?? ActiveEdition.RSWStartDate))
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Scout"
                                      Context="scout"
                                      Filterable="false"
                                      Sortable="false"
                                      TextAlign="TextAlign.Right"
                                      Frozen="true"
                                      Width="10rem"
                                      FrozenPosition="FrozenColumnPosition.Right">
                    <HeaderTemplate>
                        @if (ScoutsLists.TryGetValue(patrol, out var gridRef))
                        {
                            <RadzenButton Icon="add_circle"
                                          ButtonStyle="ButtonStyle.Success"
                                          Variant="Variant.Flat"
                                          Size="ButtonSize.Medium"
                                          class="rz-me-4 rz-display-none rz-display-sm-inline"
                                          Shade="Shade.Lighter"
                                          Click="@(() => Insert(patrol, gridRef))" />
                        }
                    </HeaderTemplate>
                    <Template Context="criteria">
                        @if (ScoutsLists.TryGetValue(patrol, out var gridRef2))
                        {
                            <RadzenButton Icon="add_circle"
                                          ButtonStyle="ButtonStyle.Success"
                                          Variant="Variant.Flat"
                                          Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter"
                                          Click="@(() => InsertAfterRow(patrol, gridRef2, criteria))" />
                        }
                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Flat"
                                      Size="ButtonSize.Medium"
                                      Shade="Shade.Lighter"
                                      class="rz-my-1 rz-ms-1 rz-me-4"
                                      Click="@(args => DeleteRow(patrol, ScoutsLists[patrol], criteria))"
                                      @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </text>;
        };
    }

    // ------------ Dialog openers ------------
    private async Task OpenLinkDialogWithCurrentUnitAsync()
    {
        if (Unit == null) return;

        var parameters = new Dictionary<string, object?>
        {
            ["UnitId"] = Unit.Id,
            ["UnitName"] = Unit.Name,
            ["AssociationName"] = Association?.Name
        };

        var result = await DialogService.OpenAsync<UnitLinkRequestDialog>(
            "Koppeling met Groep aanvragen",
            parameters,
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

        // optioneel: feedback na succesvol indienen
        if (result is RSW.Domain.Dto.CreateUnitLinkRequestResponse resp && resp.Success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Aanvraag ingediend", "We brengen je op de hoogte zodra de organisatie reageert.");
        }
    }

    private async Task OpenLinkDialogWithoutUnitAsync()
    {
        var result = await DialogService.OpenAsync<UnitLinkRequestDialog>(
            "Koppeling met Groep aanvragen",
            new Dictionary<string, object?>(), // geen prefill
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

        if (result is RSW.Domain.Dto.CreateUnitLinkRequestResponse resp && resp.Success)
        {
            //NotificationService.Notify(NotificationSeverity.Success, "Aanvraag ingediend", "We brengen je op de hoogte zodra de organisatie reageert.");
        }
    }
}
