@page "/admin/associations"
@attribute [Authorize(Roles = "Admin")]

@inject IAssociationService AssociationService

<h3>Associations</h3>

@if (associations == null)
{
    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <AssociationList associations="@associations.ToList()" />
}

@code {
    public IEnumerable<Association>? associations { get; set; }
    protected override async Task OnInitializedAsync()
    {
        associations = await AssociationService.GetAllAsync();
        foreach(Association association in associations){
            association.Groups = (await AssociationService.GetUnitsAsync(association.Id)).ToList();
        }
        await base.OnInitializedAsync();
    }
}
