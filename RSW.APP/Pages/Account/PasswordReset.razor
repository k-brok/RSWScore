@page "/passwordreset"
@using RSW.Domain.Dto
@inject NavigationManager Navigation

<h3>Wachtwoord resetten</h3>

@if (string.IsNullOrWhiteSpace(Token))
{
    @if (!tokenRequested)
    {
        <!-- Geen token aanwezig -> toon token aanvraag form -->
        <ResetPasswordTokenForm OnResetTokenSuccess="@OnResetTokenRequested"
                                OnResetTokenFailed="@OnResetTokenFailed" />
    }
    else
    {
        <!-- Succesmelding na aanvragen -->
        <RadzenAlert Severity="AlertSeverity.Info" Style="margin-top: 20px;">
            Er is een e-mail gestuurd met instructies om je wachtwoord te resetten.
            Controleer je inbox (en eventueel je spamfolder).
        </RadzenAlert>
    }
}
else
{
    <!-- Token aanwezig -> toon reset form -->
    <ResetPasswordForm Email="@Email"
                       Token="@Token"
                       ShowEmailField="@string.IsNullOrWhiteSpace(Email)"
                       ShowTokenField="@string.IsNullOrWhiteSpace(Token)"
                       OnResetPasswordSuccess="@OnPasswordResetSuccess"
                       OnResetPasswordFailed="@OnPasswordResetFailed" />
}

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private bool tokenRequested = false;

    private void OnResetTokenRequested()
    {
        tokenRequested = true;
    }

    private void OnResetTokenFailed(string error)
    {
        // Je kunt hier een foutmelding tonen of loggen
        Console.WriteLine("Fout bij aanvragen reset token: " + error);
    }

    private void OnPasswordResetSuccess()
    {
        Console.WriteLine("Wachtwoord succesvol gereset.");
        Navigation.NavigateTo("/login");
    }

    private void OnPasswordResetFailed(string error)
    {
        Console.WriteLine("Fout bij resetten wachtwoord: " + error);
    }
}
