<RadzenPanelMenu>
    <RadzenPanelMenuItem Text="Home" Path="/" Icon="home" />
    <RadzenPanelMenuItem Text="Inschrijving" Path="/signup" Icon="app_registration" />

    <AuthorizeView Roles="Admin">
        <Authorized>
            <RadzenPanelMenuItem Text="Gebruikers" Path="/admin/users" Icon="event" />
            <RadzenPanelMenuItem Text="Admin" Icon="admin_panel_settings">
                
                <!-- Structuur / Organisatie -->
                <RadzenPanelMenuItem Text="Structuur" Icon="account_tree">
                    <RadzenPanelMenuItem Text="Verenigingen" Path="/admin/associations" Icon="groups" />
                    <RadzenPanelMenuItem Text="Groepen" Path="/admin/units" Icon="group" />
                    <RadzenPanelMenuItem Text="Sub-kampen" Path="/admin/subgroups" Icon="camping" />
                </RadzenPanelMenuItem>

                <!-- Inhoud / Wedstrijd -->
                <RadzenPanelMenuItem Text="Wedstrijdbeheer" Icon="emoji_events">
                    <RadzenPanelMenuItem Text="Edities" Path="/admin/editions" Icon="event" />
                    <RadzenPanelMenuItem Text="Categoriëen" Path="/admin/categories" Icon="category" />
                    <RadzenPanelMenuItem Text="Sub-categoriëen" Path="/admin/subcategories" Icon="subdirectory_arrow_right" />
                    <RadzenPanelMenuItem Text="Criterias" Path="/admin/criterias" Icon="rule" />
                    <RadzenPanelMenuItem Text="Scores" Path="/admin/scores" Icon="scoreboard" />
                </RadzenPanelMenuItem>

                <!-- Gebruikersbeheer -->
                <RadzenPanelMenuItem Text="Gebruikersbeheer" Icon="supervisor_account">
                    <RadzenPanelMenuItem Text="Scouts" Path="/admin/scouts" Icon="explore" />
                    <RadzenPanelMenuItem Text="Patrouille's" Path="/admin/patrols" Icon="explore" />
                    <RadzenPanelMenuItem Text="Jury codes" Path="/admin/juryslots" Icon="badge" />
                    <RadzenPanelMenuItem Text="Inschrijf codes" Path="/admin/signupcodes" Icon="qr_code" />
                </RadzenPanelMenuItem>

                <!-- Vrijwilligers -->
                <RadzenPanelMenuItem Text="Vrijwilligers" Icon="volunteer_activism">
                    <RadzenPanelMenuItem Text="Taken" Path="/admin/volunteertasks" Icon="checklist" />
                    <RadzenPanelMenuItem Text="Inschrijvingen" Path="/admin/volunteerassignments" Icon="assignment_turned_in" />
                </RadzenPanelMenuItem>

            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <RadzenPanelMenuItem Text="Word Vrijwilliger" Path="/vrijwilliger-aanmelden" Icon="how_to_reg" />

    <AuthorizeView>
        <Authorized>
            <RadzenPanelMenuItem Text="Mijn gegevens" Path="/user" Icon="person" />
        </Authorized>
    </AuthorizeView>
</RadzenPanelMenu>
